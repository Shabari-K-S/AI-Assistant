<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOverlayLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:fitsSystemWindows="true">

    <!-- Entire Screen Dismiss Backdrop (Tap anywhere to dismiss overlay) -->
    <View
        android:id="@+id/viewDismissBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Dismiss assistant overlay" />

    <!-- ═══════════════════════════════════════════════════════════════
         Perplexity-Style Floating HUD (Zero Heavy Sheet Box)
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/floatingAssistantContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:animateLayoutChanges="true">

        <!-- 1. Floating Crystalline AI Orb -->
        <com.assistant.athena.ui.OrbView
            android:id="@+id/orbView"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <!-- 2. Assistant Branding Title (Clean Lowercase 'athena' / 'perplexity') -->
        <TextView
            android:id="@+id/txtAssistantTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="athena"
            android:textColor="#F1F5F9"
            android:textSize="18.5sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:layout_marginBottom="12dp" />

        <!-- Screen Context Attached Preview Badge / Card -->
        <LinearLayout
            android:id="@+id/cardScreenContextPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/chip_background"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Small Rounded Thumbnail -->
            <ImageView
                android:id="@+id/imgScreenThumbnail"
                android:layout_width="32dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:background="#1E293B"
                android:contentDescription="Screen Context Thumbnail" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/txtScreenContextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 Screen Context Attached"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to ask Athena about this screen"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRemoveScreenContext"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:padding="5dp"
                app:tint="#64748B"
                android:contentDescription="Remove screenshot" />
        </LinearLayout>

        <!-- 3. Floating Suggestion Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:id="@+id/scrollSuggestionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chipNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/chip_notifications"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/chip_screen"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipNews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/chip_news"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/chip_schedule"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chipSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/chip_system"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 4. Floating Dynamic Audio Waveform Visualizer -->
        <com.assistant.athena.ui.AudioWaveformView
            android:id="@+id/waveformVisualizer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp" />

        <!-- 5. Floating AI Response Area (Shows Transcribed Query + Status + Response) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/cardResponseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="240dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_background"
            android:padding="14dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- User Transcribed Query -->
                <LinearLayout
                    android:id="@+id/layoutUserPromptRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="› "
                        android:textColor="#00F2FE"
                        android:textSize="15sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtUserPrompt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#E2E8F0"
                        android:textSize="14.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:textIsSelectable="true"
                        tools:text="“Hi”" />
                </LinearLayout>

                <!-- Live Status / Tool Telemetry -->
                <TextView
                    android:id="@+id/txtStatusTelemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="⚡ Reasoning with AI…" />

                <!-- Divider -->
                <View
                    android:id="@+id/viewPromptDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E293B"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- AI Response Text -->
                <TextView
                    android:id="@+id/txtResponseContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Hello! How can I assist you today?" />

                <!-- Action Buttons (Copy & Speak) -->
                <LinearLayout
                    android:id="@+id/layoutResponseActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageButton
                        android:id="@+id/btnCopyResponse"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        app:tint="#94A3B8"
                        android:padding="6dp"
                        android:contentDescription="Copy response" />

                    <ImageButton
                        android:id="@+id/btnSpeakResponse"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_speaker"
                        app:tint="#94A3B8"
                        android:padding="6dp"
                        android:contentDescription="Read aloud" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 6. Floating Text Input Bar (Keyboard Mode) -->
        <LinearLayout
            android:id="@+id/layoutTextInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_bar_background"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <EditText
                android:id="@+id/editQueryInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/type_query_hint"
                android:textColorHint="#64748B"
                android:textColor="#F8FAFC"
                android:textSize="14.5sp"
                android:maxLines="3"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine" />

            <ImageButton
                android:id="@+id/btnSendTextQuery"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/btn_action_circle"
                android:src="@drawable/ic_send"
                app:tint="#38BDF8"
                android:padding="9dp"
                android:contentDescription="Send query" />
        </LinearLayout>

        <!-- 7. Floating Bottom Action Toolbar (Keyboard, Vision Lens, Edit/Mic) -->
        <RelativeLayout
            android:id="@+id/layoutBottomToolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Left: Keyboard Mode Button -->
            <ImageButton
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_keyboard"
                app:tint="#CBD5E1"
                android:padding="9dp"
                android:contentDescription="Open keyboard" />

            <!-- Center: Vision / Screen Lens Button [ O ] -->
            <ImageButton
                android:id="@+id/btnVisionSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerInParent="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_vision"
                app:tint="#F8FAFC"
                android:padding="8dp"
                android:contentDescription="Screen context search" />

            <!-- Right: Mic / Edit Button -->
            <ImageButton
                android:id="@+id/btnMicAction"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                app:tint="#CBD5E1"
                android:padding="9dp"
                android:contentDescription="Edit query" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
