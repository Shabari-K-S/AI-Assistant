<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ═══ Header ═══ -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="A.T.H.E.N.A."
            android:textColor="#E0E0E0"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="Adaptive Thinking Hands-free Engine\nfor Neural Assistance"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <!-- ═══ Service Status Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice Bridge"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtServiceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴  Voice Bridge: STOPPED"
                android:textColor="#E53935"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ═══ Primary Toggle Button ═══ -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="▶  Start ATHENA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_rounded"
            android:layout_marginBottom="12dp" />

        <!-- ═══ Test Query Button ═══ -->
        <Button
            android:id="@+id/btnTestQuery"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="⚡  Test Voice Uplink (Speak 'Hello Athena')"
            android:textColor="#41E6FF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/card_background"
            android:layout_marginBottom="16dp" />

        <!-- ═══ Live Activity Log Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <div
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Activity &amp; Transcripts"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtLiveLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:text="[Ready] Tap 'Start ATHENA' or say 'Athena, what time is it?'"
                android:textColor="#80D8FF"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- ═══ Backend Status Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Termux Backend"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtBackendStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏳  Checking Termux backend..."
                android:textColor="#FF9800"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCheckBackend"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Check Connection"
                android:textColor="#BB86FC"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="?attr/selectableItemBackground"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ═══ Permissions Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Permissions"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txtPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textColor="#E0E0E0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ═══ Settings Card ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-start on boot"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAutoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#BB86FC"
                android:trackTint="#424242" />
        </LinearLayout>

        <!-- ═══ Footer ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/footer_instructions"
            android:textColor="#616161"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
