# --- API keys (never commit real values) ---
# Stage 3 LLM. Free key from Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=

# --- Model / provider selection ---
# STT: google (Free Google SpeechRecognition - recommended for Mobile/Termux/NetHunter) | gemini | groq | local (faster-whisper)
EV_STT_PROVIDER=local
# STT model: tiny, base, small, medium, large-v3 for local; gemini-2.5-flash or gemini-3.5-flash for gemini
EV_STT_MODEL=small
EV_STT_DEVICE=cpu
EV_STT_COMPUTE_TYPE=int8
EV_STT_LANGUAGE=
# Silero VAD before transcription. false = trust the trigger's silence
# detection; the noisy RDP mic relay makes Silero reject real speech
EV_STT_VAD=false

# LLM — stage 3
# gemini = Google AI Studio API (needs GOOGLE_API_KEY)
# rest   = Pure-Python REST Gemini SSE (no compiled dependencies)
# ollama = local Ollama server (no key; run `ollama pull gemma4:e4b`)
# llama_cpp = local high-performance llama.cpp / llama-server on Android/desktop
EV_LLM_PROVIDER=gemini
EV_LLM_MODEL=gemma-4-31b-it
EV_LLM_MAX_TOKENS=2048
EV_LLM_TEMPERATURE=0.7
EV_LLM_MAX_TURNS=20
EV_LLM_TIMEOUT=60
# enable HIGH thinking level (slower, deeper reasoning; off by default)
EV_GEMINI_THINKING=false
# only used when EV_LLM_PROVIDER=ollama
EV_OLLAMA_BASE_URL=http://localhost:11434
EV_OLLAMA_MODEL=gemma4:e4b
# only used when EV_LLM_PROVIDER=llama_cpp
EV_LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
EV_LLAMA_CPP_MODEL=qwen2.5-1.5b-instruct
EV_LLAMA_CPP_CTX_SIZE=2048
EV_LLAMA_CPP_THREADS=4
# personality: persona.md by default; EV_PERSONA_PROMPT overrides it
EV_PERSONA_FILE=persona.md

# TTS: edge (default female voice: en-US-AriaNeural) | gtts (Free Google TTS for Mobile/Termux) | piper (local onnx) | elevenlabs (API)
EV_TTS_PROVIDER=edge
EV_EDGE_TTS_VOICE=en-US-AriaNeural
EV_EDGE_TTS_RATE=+0%
EV_EDGE_TTS_PITCH=+0Hz
EV_EDGE_TTS_VOLUME=+0%
EV_TTS_VOICE_ID=
EV_PIPER_VOICE_PATH=./voices/voice.onnx
EV_PIPER_VOICE_RATE=1.0
# Set ANDROID_TTS_MODE=true if you want Termux backend to mute local speaker output and let the Android client app speak
ANDROID_TTS_MODE=false

# --- Tools & Safety ---
# set to false for pure ultra-low latency voice conversation (bypasses all tool schemas)
EV_TOOLS_ENABLED=true
# confirm before running shell commands (never / always / ask)
EV_CONFIRM_SHELL=ask
EV_SHELL_TIMEOUT_SECONDS=30

# --- Audio ---
# Comma-separated allowlist prefixes for run_shell_command, e.g. "ls,cat,pwd,df"
EV_SHELL_ALLOWLIST=ls,cat,head,tail,df,uptime,pwd,echo,date,whoami,uname
EV_AUDIO_INPUT_DEVICE=
EV_PTT_KEY=space
EV_PRE_ROLL_SECONDS=1.5
EV_LOG_LEVEL=INFO

# --- Trigger: web (recommended for Mobile / Termux / Web HUD — leaves mic 100% free for browser) | ptt | wakeword ---
EV_TRIGGER=web
# bundled openWakeWord names (hey_jarvis, hey_marvin, alexa, hey_mycroft) or
# paths to custom .onnx models, comma-separated
EV_WAKE_WORDS=sara
# custom trained classifier (.npz from voices/); overrides the bundled models
EV_WAKE_WORD_WEIGHTS=./voices/sara_wake.npz
# higher = fewer false positives (0.3-0.7 is the usual tuning range)
EV_WAKE_WORD_THRESHOLD=0.8
# pause allowed right after the wake word before end-of-speech starts counting
EV_WAKE_GRACE_SECONDS=1.2
# silence this long (after the grace period) ends the utterance
EV_WAKE_END_SILENCE_SECONDS=1.0
# RMS below this counts as silence (float32 audio)
EV_WAKE_SILENCE_RMS=0.02
# leading phrase(s) stripped from the transcript, comma-separated
EV_WAKE_PHRASES=sara
